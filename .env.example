# Runtime: DEMO, LOCAL, or PRODUCTION
TRUTHLENS_MODE=DEMO
TRUTHLENS_LOG_LEVEL=INFO
TRUTHLENS_CORS_ORIGINS=http://localhost:3000
TRUTHLENS_MAX_INPUT_CHARS=50000
TRUTHLENS_MAX_UPLOAD_BYTES=10485760
TRUTHLENS_REQUEST_TIMEOUT_SECONDS=120
# All Hugging Face and Sentence Transformers cache files remain inside this repository.
TRUTHLENS_MODEL_CACHE=.cache/huggingface

# Models (downloaded only in LOCAL/PRODUCTION when enabled)
TRUTHLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TRUTHLENS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TRUTHLENS_VERIFIER_MODEL=cross-encoder/nli-deberta-v3-small
# DEMO mode still uses the deterministic provider. LOCAL/PRODUCTION use this baseline.
TRUTHLENS_VERIFIER_PROVIDER=baseline
TRUTHLENS_FINETUNED_ADAPTER=

# Retrieval
TRUTHLENS_VECTOR_BACKEND=faiss
# FAISS is currently in memory; TRUTHLENS_FAISS_PATH is reserved but unused.
TRUTHLENS_QDRANT_URL=
TRUTHLENS_QDRANT_API_KEY=
TRUTHLENS_QDRANT_COLLECTION=truthlens-evidence
TRUTHLENS_CHUNK_SIZE=700
TRUTHLENS_CHUNK_OVERLAP=100
TRUTHLENS_TOP_K=8
TRUTHLENS_RERANK_K=4

# Browser-visible API endpoint (apps/web/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional deployment/development integrations
NGROK_AUTHTOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
